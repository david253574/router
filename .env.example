# Production Mode Configuration
# Set to 'production' for live environments
NODE_ENV=development

# Application Port
PORT=3000

# Administrator Credentials
# Username for the management dashboard
ADMIN_USERNAME=admin

# Password Hash
# Generate via: node -e "console.log(require('bcryptjs').hashSync('your_password', 10))"
ADMIN_PASSWORD_HASH=

# Session Secret (must be a strong, random string in production)
SESSION_SECRET=

# Database Connection (libSQL/Turso URL or Vercel Postgres abstraction)
# Example: libsql://your-database-url.turso.io
# Leave blank in development to use local 'vercel-database.sqlite'
DATABASE_URL=
DATABASE_AUTH_TOKEN=
